# Supabase — Project Settings -> API, and Settings -> Data API for the URL.
# NO NEXT_PUBLIC_ PREFIX. Vercel withholds Secret-type vars at build time and
# Next inlines NEXT_PUBLIC_ at build time; the combination fails silently.
# Config is resolved at runtime instead — see src/lib/supabase/config.ts.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — console.anthropic.com. Workspace-scoped key is fine.
ANTHROPIC_API_KEY=

# Stripe — optional. Without these, upgrading reports "Stripe isn't configured"
# and nothing else breaks. Use test keys (sk_test_…).
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Optional. Set it and Vercel Cron sends it as a bearer token to /api/keepalive
# so only the cron can run it. Any random string.
CRON_SECRET=
